<Project>
  <PropertyGroup Condition="'$(IsPackable)' == 'true' and '$(PackageLicenseExpression)' == '' and '$(PackageLicenseFile)' == ''">
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsPackable)' == 'true' and '$(PackageIcon)' == ''">
    <_RepositoryPackageIconPath>$(MSBuildThisFileDirectory)docs\package-icon.png</_RepositoryPackageIconPath>
    <PackageIcon>package-icon.png</PackageIcon>
    <_UseRepositoryPackageIcon>true</_UseRepositoryPackageIcon>
  </PropertyGroup>
  <ItemGroup Condition="'$(_UseRepositoryPackageIcon)' == 'true' and Exists('$(_RepositoryPackageIconPath)')">
    <None Remove="$(_RepositoryPackageIconPath)" />
    <None Include="$(_RepositoryPackageIconPath)"
          Pack="true"
          PackagePath="\"
          Link="package-icon.png" />
  </ItemGroup>

  <PropertyGroup Condition="'$(IsPackable)' == 'true' and '$(PackageThirdPartyNoticesFile)' == '' and Exists('$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md')">
    <PackageThirdPartyNoticesFile>THIRD-PARTY-NOTICES.md</PackageThirdPartyNoticesFile>
    <_UseRepositoryThirdPartyNotices>true</_UseRepositoryThirdPartyNotices>
  </PropertyGroup>
  <ItemGroup Condition="'$(_UseRepositoryThirdPartyNotices)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md"
          Pack="true"
          PackagePath="\"
          Link="THIRD-PARTY-NOTICES.md" />
  </ItemGroup>

  <Target Name="ValidateCanDoItAllPackageLegalAndIconMetadata"
          BeforeTargets="Pack"
          Condition="'$(IsPackable)' == 'true'">
    <Error Condition="'$(CanDoItAllAllowPackageLicenseException)' != 'true' and '$(PackageLicenseExpression)' != 'MIT'"
           Text="CanDoItAll packages must use PackageLicenseExpression MIT unless an owner-approved exception is explicit." />
    <Error Condition="'$(CanDoItAllAllowPackageLicenseException)' != 'true' and '$(PackageLicenseFile)' != ''"
           Text="CanDoItAll packages using pure MIT must not set PackageLicenseFile." />
    <Error Condition="'$(CanDoItAllAllowPackageIconException)' != 'true' and '$(PackageIcon)' != 'package-icon.png'"
           Text="CanDoItAll packages must declare package-icon.png unless an approved product-specific icon exception is explicit." />
    <Error Condition="'$(CanDoItAllAllowPackageIconException)' != 'true' and !Exists('$(MSBuildThisFileDirectory)docs\package-icon.png')"
           Text="Copy the approved SharedInfo package icon to docs\package-icon.png before packing." />
  </Target>
</Project>
