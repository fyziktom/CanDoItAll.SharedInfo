# Copy to ignored .env for local development. These are not production credentials.
COMPOSE_PROJECT_NAME=candoitall-sample
CDA_BIND_ADDRESS=127.0.0.1
API_PORT=8080
API_IMAGE=candoitall-sample-api:dev
API_MEMORY_LIMIT=512m
API_CPU_LIMIT=1.0
API_PID_LIMIT=256

POSTGRES_IMAGE_TAG=17-alpine
POSTGRES_DB=sample
POSTGRES_USER=sample
POSTGRES_PASSWORD=replace-for-local-development
DB_MEMORY_LIMIT=1g
DB_CPU_LIMIT=1.0
DB_PID_LIMIT=256

